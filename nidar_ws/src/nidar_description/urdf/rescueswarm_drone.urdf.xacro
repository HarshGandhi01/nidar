<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rescueswarm_drone">

  <xacro:arg name="drone_name" default="drone_1"/>

  <xacro:property name="name" value="$(arg drone_name)"/>
  <xacro:property name="base_mass" value="2.0"/>

  <link name="${name}_base_footprint"/>

  <joint name="${name}_base_joint" type="fixed">
    <parent link="${name}_base_footprint"/>
    <child link="${name}_base_link"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
  </joint>

  <link name="${name}_base_link">
    <inertial>
      <mass value="${base_mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.04" ixy="0.0" ixz="0.0" iyy="0.04" iyz="0.0" izz="0.07"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.5 0.5 0.15"/>
      </geometry>
      <material name="dark_blue">
        <color rgba="0.1 0.2 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.5 0.5 0.15"/>
      </geometry>
    </collision>
  </link>

  <!-- Payload Attachment Box (20cm x 10cm x 5cm, 200g) -->
  <link name="${name}_payload_link">
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0007" iyz="0" izz="0.0008"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.20 0.10 0.05"/>
      </geometry>
      <material name="yellow">
        <color rgba="0.9 0.8 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.20 0.10 0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="${name}_payload_joint" type="fixed">
    <parent link="${name}_base_link"/>
    <child link="${name}_payload_link"/>
    <origin xyz="0 0 -0.1" rpy="0 0 0"/>
  </joint>

  <!-- Downward Camera -->
  <link name="${name}_downward_camera_link">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.03"/>
      </geometry>
      <material name="green">
        <color rgba="0.1 0.7 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="${name}_downward_camera_joint" type="fixed">
    <parent link="${name}_base_link"/>
    <child link="${name}_downward_camera_link"/>
    <origin xyz="0.1 0 -0.08" rpy="0 1.5707963 0"/>
  </joint>

  <link name="${name}_imu_link"/>
  <joint name="${name}_imu_joint" type="fixed">
    <parent link="${name}_base_link"/>
    <child link="${name}_imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo Sensors -->
  <gazebo reference="${name}_downward_camera_link">
    <sensor name="${name}_cam" type="camera">
      <update_rate>20</update_rate>
      <topic>/${name}/downward_camera/image_raw</topic>
      <gz_frame_id>${name}_downward_camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.5707963</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="${name}_imu_link">
    <sensor name="${name}_imu" type="imu">
      <update_rate>100</update_rate>
      <topic>/${name}/imu</topic>
      <gz_frame_id>${name}_imu_link</gz_frame_id>
      <always_on>1</always_on>
    </sensor>
  </gazebo>

  <gazebo reference="${name}_base_link">
    <sensor name="${name}_navsat" type="navsat">
      <update_rate>10</update_rate>
      <topic>/${name}/navsat</topic>
      <always_on>1</always_on>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin
      filename="gz-sim-multicopter-control-system"
      name="gz::sim::systems::MulticopterVelocityControl">
      <robotNamespace>${name}</robotNamespace>
      <commandSubTopic>cmd_vel</commandSubTopic>
      <enableSubTopic>enable</enableSubTopic>
      <comLinkName>${name}_base_link</comLinkName>
      <velocityGain>2.7 2.7 2.7</velocityGain>
      <attitudeGain>2.0 2.0 2.0</attitudeGain>
      <angularRateGain>0.4 0.4 0.4</angularRateGain>
      <maximumLinearVelocity>5.0 5.0 5.0</maximumLinearVelocity>
      <maximumAngularVelocity>3.0 3.0 3.0</maximumAngularVelocity>
    </plugin>
  </gazebo>

</robot>
